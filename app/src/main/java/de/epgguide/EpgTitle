package de.epgguide

import androidx.compose.foundation.layout.BoxWithConstraints
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextOverflow
import androidx.compose.ui.unit.TextUnit
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import kotlin.math.max

/**
 * Robuste Titelanzeige für EPG-Blöcke.
 *
 * Der Sendungstitel wird auf maximal drei Zeilen verteilt.
 * Wenn nötig, werden auch lange Wörter getrennt.
 * Erst nach der dritten Zeile wird ein Auslassungszeichen angefügt.
 */
@Composable
fun EpgEventTitle(
    title: String,
    running: Boolean,
    titleSize: TextUnit,
    modifier: Modifier = Modifier
) {
    BoxWithConstraints(
        modifier = modifier.fillMaxWidth()
    ) {
        val cleanTitle = title
            .trim()
            .ifBlank { "Keine Programminfo" }

        /*
         * Näherungswert für die Anzahl sichtbarer Zeichen pro Zeile.
         * Auch in sehr schmalen EPG-Blöcken bleiben mindestens zwei
         * Zeichen pro Zeile sichtbar.
         */
        val averageCharacterWidthDp = max(
            5f,
            titleSize.value * 0.52f
        )

        val charactersPerLine = max(
            2,
            (maxWidth.value / averageCharacterWidthDp).toInt()
        )

        val visibleTitle = wrapAndEllipsize(
            text = cleanTitle,
            charactersPerLine = charactersPerLine,
            maximumLines = 3
        )

        Text(
            text = visibleTitle,
            modifier = Modifier
                .fillMaxWidth()
                .padding(horizontal = 1.dp),
            fontSize = titleSize,
            lineHeight = (titleSize.value * 1.02f).sp,
            maxLines = 3,
            softWrap = true,
            overflow = TextOverflow.Clip,
            color = if (running) {
                MaterialTheme.colorScheme.onPrimaryContainer
            } else {
                MaterialTheme.colorScheme.onSurfaceVariant
            },
            fontWeight = if (running) {
                FontWeight.Bold
            } else {
                FontWeight.Normal
            }
        )
    }
}

/**
 * Verteilt einen Titel auf maximal drei Zeilen.
 *
 * Normale Wörter werden möglichst vollständig verwendet.
 * Wörter, die breiter als eine Zeile sind, werden innerhalb
 * des Wortes getrennt. Wenn Text übrig bleibt, endet die
 * dritte Zeile mit einem Auslassungszeichen.
 */
private fun wrapAndEllipsize(
    text: String,
    charactersPerLine: Int,
    maximumLines: Int
): String {
    val lineLimit = charactersPerLine.coerceAtLeast(2)

    val words = text
        .split(Regex("\\s+"))
        .filter { it.isNotBlank() }

    if (words.isEmpty()) {
        return "Keine Programminfo"
    }

    val lines = mutableListOf<String>()

    var currentLine = ""
    var wordIndex = 0
    var remainder = ""

    while (
        lines.size < maximumLines &&
        (wordIndex < words.size || remainder.isNotEmpty())
    ) {
        var word = if (remainder.isNotEmpty()) {
            remainder.also { remainder = "" }
        } else {
            words[wordIndex++]
        }

        /*
         * Ist ein einzelnes Wort breiter als die komplette Zeile,
         * wird das Wort in sichtbare Teile aufgeteilt.
         */
        while (
            word.length > lineLimit &&
            lines.size < maximumLines
        ) {
            if (currentLine.isNotEmpty()) {
                lines += currentLine
                currentLine = ""

                if (lines.size >= maximumLines) {
                    remainder = word
                    break
                }
            }

            lines += word.take(lineLimit)
            word = word.drop(lineLimit)

            if (lines.size >= maximumLines) {
                remainder = word
                break
            }
        }

        if (lines.size >= maximumLines) {
            break
        }

        if (word.isEmpty()) {
            continue
        }

        val candidate = if (currentLine.isEmpty()) {
            word
        } else {
            "$currentLine $word"
        }

        if (candidate.length <= lineLimit) {
            currentLine = candidate
        } else {
            if (currentLine.isNotEmpty()) {
                lines += currentLine
            }

            currentLine = word
        }
    }

    if (
        lines.size < maximumLines &&
        currentLine.isNotEmpty()
    ) {
        lines += currentLine
    }

    val normalizedOriginal = text
        .replace(Regex("\\s+"), " ")
        .trim()

    val normalizedVisible = lines
        .joinToString(" ")
        .replace("…", "")
        .trim()

    val hasRemainingText =
        remainder.isNotEmpty() ||
            wordIndex < words.size ||
            normalizedVisible.length < normalizedOriginal.length

    if (hasRemainingText && lines.isNotEmpty()) {
        val lastLine = lines
            .last()
            .take((lineLimit - 1).coerceAtLeast(1))
            .trimEnd()

        lines[lines.lastIndex] = "$lastLine…"
    }

    return lines
        .take(maximumLines)
        .joinToString("\n")
}
